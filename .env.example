# LLM Configuration
LLM_MODE=scripted
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_RPM=10

# Cost & Budget Guardrails (USD)
COST_BUDGET_USD=0.50
PRICE_INPUT_PER_M=1.50
PRICE_OUTPUT_PER_M=7.50

# Policy & Thresholds
SENIOR_PO_THRESHOLD_USD=10000.0
LOW_CONFIDENCE=0.6
SERVICE_LEVEL=0.95

# Storage & Database Paths
SUPPLY_DB=data/supply.db
APP_DB=data/app.db
AUDIT_PATH=audit/audit.jsonl

# Logging & Observability
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supply-chain-agents
